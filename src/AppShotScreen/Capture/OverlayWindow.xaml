<Window x:Class="AppShotScreen.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" Title="APPSHOTACREEN - Seleccionar región">
    <Grid x:Name="Root">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Path x:Name="Dim" Fill="#99000000" IsHitTestVisible="False" />
        <Rectangle x:Name="SelectionBorder" Stroke="#FF29B6F6" StrokeThickness="1.5"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
        <Line x:Name="CrossH" Stroke="#8029B6F6" StrokeThickness="1" IsHitTestVisible="False" />
        <Line x:Name="CrossV" Stroke="#8029B6F6" StrokeThickness="1" IsHitTestVisible="False" />
        <Border x:Name="SizeLabel" Background="#DD1E1E1E" CornerRadius="4" Padding="6,2"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" FontFamily="Segoe UI" />
        </Border>
        <Border x:Name="Hint" Background="#DD1E1E1E" CornerRadius="6" Padding="12,8"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,24,0,0" IsHitTestVisible="False">
            <TextBlock x:Name="HintLabel" Foreground="White" FontSize="13" FontFamily="Segoe UI"
                       Text="Arrastra para seleccionar  ·  Enter = pantalla completa  ·  Esc = cancelar" />
        </Border>
    </Grid>
</Window>
