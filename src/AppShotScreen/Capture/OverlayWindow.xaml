<Window x:Class="AppShotScreen.Capture.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Background="Black" Cursor="Cross" Title="APPSHOTACREEN - Seleccionar" FontFamily="Segoe UI">
    <Grid x:Name="Root">
        <Image x:Name="Shot" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
        <Path x:Name="Dim" Fill="#8C000000" IsHitTestVisible="False" />

        <!-- Ventana detectada bajo el cursor / región arrastrada -->
        <Rectangle x:Name="SelectionBorder" Stroke="#FF5B8CFF" StrokeThickness="2"
                   HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" IsHitTestVisible="False" />
        <Line x:Name="CrossH" Stroke="#665B8CFF" StrokeThickness="1" IsHitTestVisible="False" />
        <Line x:Name="CrossV" Stroke="#665B8CFF" StrokeThickness="1" IsHitTestVisible="False" />

        <Border x:Name="SizeLabel" Background="#F01A1C23" CornerRadius="6" Padding="8,3"
                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock x:Name="SizeText" Foreground="White" FontSize="12" />
        </Border>

        <!-- Lupa con el color del píxel -->
        <Border x:Name="Loupe" Width="146" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False"
                Background="#F01A1C23" BorderBrush="#FF5B8CFF" BorderThickness="1.5" CornerRadius="10" Visibility="Collapsed">
            <StackPanel>
                <Grid Width="143" Height="121" ClipToBounds="True">
                    <Image x:Name="LoupeImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    <Rectangle Width="11" Height="11" Stroke="White" StrokeThickness="1" />
                    <Rectangle Width="13" Height="13" Stroke="#AA000000" StrokeThickness="1" />
                </Grid>
                <DockPanel Margin="7,5,7,6">
                    <Border x:Name="LoupeSwatch" DockPanel.Dock="Left" Width="12" Height="12" CornerRadius="3" BorderBrush="#66FFFFFF" BorderThickness="1" Margin="0,0,6,0" />
                    <TextBlock x:Name="LoupeCoords" DockPanel.Dock="Right" Foreground="#FF9BA1B5" FontSize="10.5" FontFamily="Consolas" VerticalAlignment="Center" />
                    <TextBlock x:Name="LoupeText" Foreground="White" FontSize="11" FontFamily="Consolas" />
                </DockPanel>
            </StackPanel>
        </Border>

        <Border x:Name="Hint" Background="#F01A1C23" CornerRadius="10" Padding="16,10" BorderBrush="#FF2C303C" BorderThickness="1"
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,28,0,0" IsHitTestVisible="False">
            <TextBlock x:Name="HintLabel" Foreground="White" FontSize="13"
                       Text="Arrastra para elegir una región  ·  Clic para capturar la ventana resaltada  ·  Enter = todo  ·  C = copiar color  ·  Esc = cancelar" />
        </Border>
    </Grid>
</Window>
