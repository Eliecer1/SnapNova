<Window x:Class="AppShotScreen.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="APPSHOTACREEN - Editor" Width="1100" Height="760" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen" Background="#FF1F1F23" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF34343A" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF2F6FED" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Background" Value="#FF2C2C32" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF3D3D45" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse Fill="{TemplateBinding Background}" Stroke="#FF5A5A60" StrokeThickness="1" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFE6E6E6" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Barra de herramientas -->
        <Border DockPanel.Dock="Top" Background="#FF26262B" Padding="8" BorderBrush="#FF34343A" BorderThickness="0,0,0,1">
            <WrapPanel VerticalAlignment="Center">
                <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolButton}" Content="➜ Flecha" IsChecked="True" ToolTip="Flecha (A)" />
                <RadioButton x:Name="ToolRect" Style="{StaticResource ToolButton}" Content="▭ Rectángulo" ToolTip="Rectángulo (R)" />
                <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolButton}" Content="◯ Elipse" ToolTip="Elipse (E)" />
                <RadioButton x:Name="ToolHighlight" Style="{StaticResource ToolButton}" Content="▬ Resaltar" ToolTip="Resaltador (H)" />
                <RadioButton x:Name="ToolPen" Style="{StaticResource ToolButton}" Content="✎ Lápiz" ToolTip="Lápiz (P)" />
                <RadioButton x:Name="ToolText" Style="{StaticResource ToolButton}" Content="T Texto" ToolTip="Texto (T)" />
                <RadioButton x:Name="ToolStep" Style="{StaticResource ToolButton}" Content="① Paso" ToolTip="Pasos numerados (S)" />
                <RadioButton x:Name="ToolBlur" Style="{StaticResource ToolButton}" Content="▦ Pixelar" ToolTip="Pixelar / ocultar datos (B)" />
                <RadioButton x:Name="ToolCrop" Style="{StaticResource ToolButton}" Content="⌗ Recortar" ToolTip="Recortar (C)" />

                <Rectangle Width="1" Height="24" Fill="#FF3D3D45" Margin="8,0" />

                <Button Style="{StaticResource Swatch}" Background="#FFE53935" Click="Swatch_Click" ToolTip="Rojo" />
                <Button Style="{StaticResource Swatch}" Background="#FFFB8C00" Click="Swatch_Click" ToolTip="Naranja" />
                <Button Style="{StaticResource Swatch}" Background="#FFFDD835" Click="Swatch_Click" ToolTip="Amarillo" />
                <Button Style="{StaticResource Swatch}" Background="#FF43A047" Click="Swatch_Click" ToolTip="Verde" />
                <Button Style="{StaticResource Swatch}" Background="#FF1E88E5" Click="Swatch_Click" ToolTip="Azul" />
                <Button Style="{StaticResource Swatch}" Background="#FF8E24AA" Click="Swatch_Click" ToolTip="Morado" />
                <Button Style="{StaticResource Swatch}" Background="#FF000000" Click="Swatch_Click" ToolTip="Negro" />
                <Button Style="{StaticResource Swatch}" Background="#FFFFFFFF" Click="Swatch_Click" ToolTip="Blanco" />
                <Border x:Name="CurrentColor" Width="28" Height="22" CornerRadius="4" Margin="6,0" BorderBrush="#FFE6E6E6" BorderThickness="1" ToolTip="Color actual" />

                <TextBlock Text="Grosor" Foreground="#FFB0B0B8" VerticalAlignment="Center" Margin="8,0,4,0" />
                <Slider x:Name="Thickness" Width="90" Minimum="1" Maximum="16" Value="4" VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1" />

                <Rectangle Width="1" Height="24" Fill="#FF3D3D45" Margin="8,0" />

                <Button x:Name="UndoBtn" Style="{StaticResource ActionButton}" Content="↶" ToolTip="Deshacer (Ctrl+Z)" Click="Undo_Click" />
                <Button x:Name="RedoBtn" Style="{StaticResource ActionButton}" Content="↷" ToolTip="Rehacer (Ctrl+Y)" Click="Redo_Click" />
            </WrapPanel>
        </Border>

        <!-- Barra inferior: efectos y exportación -->
        <Border DockPanel.Dock="Bottom" Background="#FF26262B" Padding="8" BorderBrush="#FF34343A" BorderThickness="0,1,0,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock x:Name="Status" Foreground="#FFB0B0B8" VerticalAlignment="Center" Margin="4,0,12,0" />
                    <TextBlock Text="Zoom" Foreground="#FFB0B0B8" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <Slider x:Name="Zoom" Width="110" Minimum="0.1" Maximum="3" Value="1" VerticalAlignment="Center" />
                    <Button Style="{StaticResource ActionButton}" Content="Ajustar" Click="Fit_Click" />
                    <Button Style="{StaticResource ActionButton}" Content="100 %" Click="ActualSize_Click" />
                    <CheckBox x:Name="EffShadow" Content="Sombra" ToolTip="Agrega sombra al exportar" />
                    <CheckBox x:Name="EffBorder" Content="Borde" ToolTip="Agrega borde al exportar" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource ActionButton}" Content="🔤 Extraer texto" Click="Ocr_Click" ToolTip="Reconoce el texto de la imagen y lo copia (OCR de Windows)" />
                    <Button Style="{StaticResource ActionButton}" Content="📁 Carpeta" Click="OpenFolder_Click" />
                    <Button Style="{StaticResource ActionButton}" Content="Guardar como…" Click="SaveAs_Click" />
                    <Button Style="{StaticResource ActionButton}" Content="💾 Guardar" Click="Save_Click" ToolTip="Ctrl+S" />
                    <Button Style="{StaticResource ActionButton}" Content="📋 Copiar" Click="Copy_Click" Background="#FF2F6FED" ToolTip="Ctrl+C" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Lienzo -->
        <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#FF17171A">
            <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Grid.LayoutTransform>
                    <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                </Grid.LayoutTransform>
                <Canvas x:Name="Surface" ClipToBounds="True" Background="White" Cursor="Cross">
                    <Image x:Name="BaseImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                </Canvas>
                <!-- Capa de interacción para el recorte (no se exporta) -->
                <Canvas x:Name="Interaction" IsHitTestVisible="False">
                    <Rectangle x:Name="CropRect" Stroke="#FF29B6F6" StrokeThickness="2" StrokeDashArray="4 3" Visibility="Collapsed" Fill="#2229B6F6" />
                </Canvas>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>
