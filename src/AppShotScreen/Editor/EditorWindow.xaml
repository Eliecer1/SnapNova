<Window x:Class="AppShotScreen.Editor.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SnapNova" Width="1280" Height="820" MinWidth="980" MinHeight="700"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg0}" FontFamily="Segoe UI"
        Foreground="{StaticResource Text}" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ═════════ Barra superior ═════════ -->
        <Border Grid.Row="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource AccentGradient}" Margin="2,0,10,0">
                        <Path Style="{StaticResource Ico}" Data="{StaticResource IcoRegion}" Stroke="White" StrokeThickness="2.2">
                            <Path.LayoutTransform>
                                <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
                            </Path.LayoutTransform>
                        </Path>
                    </Border>
                    <Button x:Name="UndoBtn" Style="{StaticResource GhostButton}" Tag="{StaticResource IcoUndo}" ToolTip="Deshacer (Ctrl+Z)" Click="Undo_Click" />
                    <Button x:Name="RedoBtn" Style="{StaticResource GhostButton}" Tag="{StaticResource IcoRedo}" ToolTip="Rehacer (Ctrl+Y)" Click="Redo_Click" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Slider x:Name="Zoom" Width="130" Minimum="0.1" Maximum="3" Value="1" />
                    <TextBlock x:Name="ZoomText" Width="46" TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource TextDim}" FontSize="12" Margin="6,0,6,0" />
                    <Button Style="{StaticResource GhostButton}" Content="Ajustar" Click="Fit_Click" ToolTip="Ajustar a la ventana" />
                    <Button Style="{StaticResource GhostButton}" Content="100 %" Click="ActualSize_Click" ToolTip="Tamaño real" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource GhostButton}" Tag="{StaticResource IcoFolder}" ToolTip="Abrir carpeta de capturas" Click="OpenFolder_Click" />
                    <Button Style="{StaticResource GhostButton}" Tag="{StaticResource IcoDrag}" Content="Arrastrar" Cursor="SizeAll" Click="DragOut_Click"
                            PreviewMouseLeftButtonDown="DragOut_Down" PreviewMouseMove="DragOut_Move"
                            ToolTip="Mantén pulsado y arrastra la imagen a WhatsApp, Word, un correo o una carpeta" />
                    <Button Style="{StaticResource GhostButton}" Tag="{StaticResource IcoPin}" Content="Fijar" ToolTip="Fija la imagen flotando sobre las demás ventanas" Click="Pin_Click" />
                    <Button Style="{StaticResource GhostButton}" Content="Guardar como…" Click="SaveAs_Click" />
                    <Button Style="{StaticResource SoftButton}" Tag="{StaticResource IcoSave}" Content="Guardar" ToolTip="Ctrl+S" Click="Save_Click" />
                    <Button Style="{StaticResource PrimaryButton}" Tag="{StaticResource IcoCopy}" Content="Copiar" ToolTip="Ctrl+C" Click="Copy_Click" Margin="6,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="268" />
            </Grid.ColumnDefinitions>

            <!-- ═════════ Herramientas ═════════ -->
            <Border Grid.Column="0" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <StackPanel Margin="0,10" HorizontalAlignment="Center">
                    <RadioButton x:Name="ToolSelect" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoSelect}" ToolTip="Seleccionar y mover anotaciones (V). Supr las borra." />
                    <Rectangle Height="1" Width="28" Fill="{StaticResource Line}" Margin="0,6" />
                    <RadioButton x:Name="ToolArrow" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoArrow}" IsChecked="True" ToolTip="Flecha (A)" />
                    <RadioButton x:Name="ToolRect" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoRect}" ToolTip="Rectángulo (R)" />
                    <RadioButton x:Name="ToolEllipse" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoEllipse}" ToolTip="Elipse (E)" />
                    <RadioButton x:Name="ToolHighlight" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoHighlight}" ToolTip="Resaltador (H)" />
                    <RadioButton x:Name="ToolPen" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoPen}" ToolTip="Lápiz (P)" />
                    <RadioButton x:Name="ToolText" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoText}" ToolTip="Texto (T)" />
                    <RadioButton x:Name="ToolCallout" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoCallout}" ToolTip="Globo de texto (G): arrastra desde lo que señalas hasta donde va el globo" />
                    <RadioButton x:Name="ToolStep" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoStep}" ToolTip="Pasos numerados (S)" />
                    <RadioButton x:Name="ToolStamp" Style="{StaticResource ToolButton}" Visibility="Collapsed" />
                    <Rectangle Height="1" Width="28" Fill="{StaticResource Line}" Margin="0,8" />
                    <RadioButton x:Name="ToolSpot" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoSpot}" ToolTip="Foco: oscurece todo menos la zona marcada (F)" />
                    <RadioButton x:Name="ToolMagnify" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoMagnify}" ToolTip="Lupa: amplía la zona que marques (L)" />
                    <RadioButton x:Name="ToolBlur" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoPixel}" ToolTip="Pixelar / ocultar datos (B)" />
                    <RadioButton x:Name="ToolCrop" Style="{StaticResource ToolButton}" Tag="{StaticResource IcoCrop}" ToolTip="Recortar (C)" />
                </StackPanel>
            </Border>

            <!-- ═════════ Lienzo ═════════ -->
            <Grid Grid.Column="1">
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{StaticResource Bg0}">
                    <Grid x:Name="ZoomHost" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="28,28,28,84">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="ZoomTransform" ScaleX="1" ScaleY="1" />
                        </Grid.LayoutTransform>
                        <!-- Fondo de presentación (se ve igual que el resultado exportado) -->
                        <Border x:Name="Backdrop">
                            <Grid>
                                <Border x:Name="ShadowBox" Background="#78000000" IsHitTestVisible="False" Visibility="Collapsed">
                                    <Border.RenderTransform>
                                        <TranslateTransform Y="10" />
                                    </Border.RenderTransform>
                                    <Border.Effect>
                                        <BlurEffect Radius="28" />
                                    </Border.Effect>
                                </Border>
                                <Border x:Name="FrameBorder" IsHitTestVisible="False" Visibility="Collapsed" />
                                <Canvas x:Name="Surface" ClipToBounds="True" Background="White" Cursor="Cross">
                                    <Image x:Name="BaseImage" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Canvas>
                                <!-- Capa de interacción para el recorte (no se exporta) -->
                                <Canvas x:Name="Interaction" IsHitTestVisible="False">
                                    <Rectangle x:Name="CropRect" Stroke="{StaticResource Accent}" StrokeThickness="2" StrokeDashArray="4 3" Visibility="Collapsed" Fill="#225B8CFF" />
                                </Canvas>
                            </Grid>
                        </Border>
                    </Grid>
                </ScrollViewer>

                <!-- Barra flotante de estilo -->
                <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="12,8" CornerRadius="14"
                        Background="#F21A1C23" BorderBrush="{StaticResource Line}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Direction="270" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border x:Name="CurrentColor" Width="26" Height="26" CornerRadius="8" BorderBrush="#99FFFFFF" BorderThickness="1.5" Margin="0,0,10,0" ToolTip="Color actual" />
                        <Button Style="{StaticResource Swatch}" Background="#FFE53935" Click="Swatch_Click" ToolTip="Rojo" />
                        <Button Style="{StaticResource Swatch}" Background="#FFFB8C00" Click="Swatch_Click" ToolTip="Naranja" />
                        <Button Style="{StaticResource Swatch}" Background="#FFFDD835" Click="Swatch_Click" ToolTip="Amarillo" />
                        <Button Style="{StaticResource Swatch}" Background="#FF43A047" Click="Swatch_Click" ToolTip="Verde" />
                        <Button Style="{StaticResource Swatch}" Background="#FF1E88E5" Click="Swatch_Click" ToolTip="Azul" />
                        <Button Style="{StaticResource Swatch}" Background="#FF8E24AA" Click="Swatch_Click" ToolTip="Morado" />
                        <Button Style="{StaticResource Swatch}" Background="#FF000000" Click="Swatch_Click" ToolTip="Negro" />
                        <Button Style="{StaticResource Swatch}" Background="#FFFFFFFF" Click="Swatch_Click" ToolTip="Blanco" />
                        <Rectangle Width="1" Height="22" Fill="{StaticResource Line}" Margin="12,0" />
                        <TextBlock Text="Grosor" Foreground="{StaticResource TextDim}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="Thickness" Width="96" Minimum="1" Maximum="16" Value="4" IsSnapToTickEnabled="True" TickFrequency="1" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="Status" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14,0,0,10"
                           Foreground="{StaticResource TextDim}" FontSize="12" IsHitTestVisible="False" />
            </Grid>

            <!-- ═════════ Panel derecho ═════════ -->
            <Border Grid.Column="2" Background="{StaticResource Bg1}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="18,16">
                        <TextBlock Text="PRESENTACIÓN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                        <TextBlock Text="Fondo" FontSize="13" Margin="0,12,0,8" />
                        <WrapPanel x:Name="BackgroundSwatches" Margin="-4,0" />

                        <DockPanel Margin="0,16,0,4">
                            <TextBlock x:Name="PaddingText" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="12" />
                            <TextBlock Text="Margen" FontSize="13" />
                        </DockPanel>
                        <Slider x:Name="PaddingSlider" Minimum="0" Maximum="200" Value="64" IsSnapToTickEnabled="True" TickFrequency="4" />

                        <DockPanel Margin="0,12,0,4">
                            <TextBlock x:Name="RadiusText" DockPanel.Dock="Right" Foreground="{StaticResource TextDim}" FontSize="12" />
                            <TextBlock Text="Esquinas redondeadas" FontSize="13" />
                        </DockPanel>
                        <Slider x:Name="RadiusSlider" Minimum="0" Maximum="48" Value="0" IsSnapToTickEnabled="True" TickFrequency="2" />

                        <CheckBox x:Name="ShadowToggle" Style="{StaticResource Switch}" Content="Sombra" Margin="0,16,0,0" />
                        <CheckBox x:Name="BorderToggle" Style="{StaticResource Switch}" Content="Borde" Margin="0,12,0,0" />

                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,20" />

                        <TextBlock Text="TAMAÑO DE LA IMAGEN" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                        <DockPanel Margin="0,10,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Content="Aplicar" Click="Resize_Click" Margin="8,0,0,0" />
                            <TextBox x:Name="ResizeWidth" Height="36" Background="{StaticResource Bg2}" Foreground="{StaticResource Text}" BorderBrush="{StaticResource Line}"
                                     CaretBrush="{StaticResource Text}" VerticalContentAlignment="Center" Padding="8,0" FontSize="13"
                                     KeyDown="ResizeWidth_KeyDown" GotKeyboardFocus="ResizeWidth_GotFocus"
                                     ToolTip="Ancho nuevo en píxeles (800) o porcentaje (50%). El alto se ajusta solo." />
                        </DockPanel>

                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,20" />

                        <TextBlock Text="SELLOS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                        <WrapPanel x:Name="StampButtons" Margin="-2,10,-2,0" />

                        <Rectangle Height="1" Fill="{StaticResource Line}" Margin="0,20" />

                        <TextBlock Text="ACCIONES INTELIGENTES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDim}" />
                        <Button Style="{StaticResource SoftButton}" Tag="{StaticResource IcoShield}" Content="Ocultar datos sensibles" Click="SmartRedact_Click"
                                HorizontalContentAlignment="Left" Margin="0,12,0,0" Height="40"
                                ToolTip="Detecta correos, teléfonos, tarjetas e identificaciones y los pixela" />
                        <Button Style="{StaticResource SoftButton}" Tag="{StaticResource IcoOcr}" Content="Extraer texto" Click="Ocr_Click"
                                Margin="0,8,0,0" Height="40" ToolTip="Reconoce el texto de la imagen y lo copia" />

                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="0,18,0,0" LineHeight="17"
                                   Text="Con la herramienta Seleccionar (V) mueves cualquier anotación; Supr o clic derecho la elimina. Esc cierra el editor." />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
