<Application x:Class="AppShotScreen.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- ───────── Paleta ───────── -->
        <SolidColorBrush x:Key="Bg0" Color="#FF111217" />
        <SolidColorBrush x:Key="Bg1" Color="#FF1A1C23" />
        <SolidColorBrush x:Key="Bg2" Color="#FF252833" />
        <SolidColorBrush x:Key="Bg3" Color="#FF303442" />
        <SolidColorBrush x:Key="Line" Color="#FF2C303C" />
        <SolidColorBrush x:Key="Text" Color="#FFECEDF2" />
        <SolidColorBrush x:Key="TextDim" Color="#FF9BA1B5" />
        <SolidColorBrush x:Key="Accent" Color="#FF5B8CFF" />
        <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF4F86FF" Offset="0" />
            <GradientStop Color="#FF8E5CFF" Offset="1" />
        </LinearGradientBrush>

        <!-- ───────── Iconos vectoriales (24×24) ───────── -->
        <Geometry x:Key="IcoArrow">M5,19 L19,5 M10,5 L19,5 L19,14</Geometry>
        <Geometry x:Key="IcoRect">M4,6 H20 V18 H4 Z</Geometry>
        <Geometry x:Key="IcoEllipse">M4,12 A8,7 0 1 0 20,12 A8,7 0 1 0 4,12 Z</Geometry>
        <Geometry x:Key="IcoHighlight">M6,14 L14,6 L18,10 L10,18 H6 Z M4,21 H20</Geometry>
        <Geometry x:Key="IcoPen">M4,17 C7,8 9,8 11,13 S15,18 20,7</Geometry>
        <Geometry x:Key="IcoText">M6,7 V5 H18 V7 M12,5 V19 M9,19 H15</Geometry>
        <Geometry x:Key="IcoStep">M4,12 A8,8 0 1 0 20,12 A8,8 0 1 0 4,12 Z M10.5,9.5 L12.5,8 V16</Geometry>
        <Geometry x:Key="IcoPixel">M4,4 H20 V20 H4 Z M4,9.3 H20 M4,14.6 H20 M9.3,4 V20 M14.6,4 V20</Geometry>
        <Geometry x:Key="IcoSpot">M8,9 H16 V15 H8 Z M3,4 L5.5,6.5 M21,4 L18.5,6.5 M3,20 L5.5,17.5 M21,20 L18.5,17.5</Geometry>
        <Geometry x:Key="IcoCrop">M7,3 V17 H21 M3,7 H17 V21</Geometry>
        <Geometry x:Key="IcoRegion">M4,9 V4 H9 M15,4 H20 V9 M20,15 V20 H15 M9,20 H4 V15</Geometry>
        <Geometry x:Key="IcoScreen">M3,5 H21 V16 H3 Z M8,20 H16 M12,16 V20</Geometry>
        <Geometry x:Key="IcoScroll">M7,3 H17 V21 H7 Z M12,7 V16 M9,13 L12,16 L15,13</Geometry>
        <Geometry x:Key="IcoOcr">M4,8 V4 H8 M16,4 H20 V8 M20,16 V20 H16 M8,20 H4 V16 M9,9 H15 M12,9 V16</Geometry>
        <Geometry x:Key="IcoPin">M9,3 H15 L14,10 L17,14 H7 L10,10 Z M12,14 V21</Geometry>
        <Geometry x:Key="IcoTimer">M4,13 A8,8 0 1 0 20,13 A8,8 0 1 0 4,13 Z M12,9 V13 L15,15 M10,3 H14</Geometry>
        <Geometry x:Key="IcoShield">M12,3 L19,6 V11 C19,16 16,19.5 12,21 C8,19.5 5,16 5,11 V6 Z M9,12 L11.2,14.2 L15.2,10</Geometry>
        <Geometry x:Key="IcoCopy">M9,8 H19 V20 H9 Z M15,8 V4 H5 V16 H9</Geometry>
        <Geometry x:Key="IcoSave">M5,4 H16 L20,8 V20 H5 Z M8,4 V9 H15 V4 M8,20 V14 H16 V20</Geometry>
        <Geometry x:Key="IcoFolder">M3,6 H10 L12,8 H21 V19 H3 Z</Geometry>
        <Geometry x:Key="IcoUndo">M9,7 L4,12 L9,17 M4,12 H15 A5,5 0 0 1 15,22 H12</Geometry>
        <Geometry x:Key="IcoRedo">M15,7 L20,12 L15,17 M20,12 H9 A5,5 0 0 0 9,22 H12</Geometry>
        <Geometry x:Key="IcoGif">M3,6 H21 V18 H3 Z M10,9.5 V14.5 L14.5,12 Z</Geometry>
        <Geometry x:Key="IcoSelect">M6,3 V18 L10,14.5 L12.8,20.5 L15,19.5 L12.2,13.6 H17.5 Z</Geometry>
        <Geometry x:Key="IcoCallout">M4,5 H20 V15 H11 L7,19.5 V15 H4 Z</Geometry>
        <Geometry x:Key="IcoDrag">M12,3 V15 M8,7 L12,3 L16,7 M5,13 V20 H19 V13</Geometry>
        <Geometry x:Key="IcoMagnify">M4,10.5 A6.5,6.5 0 1 0 17,10.5 A6.5,6.5 0 1 0 4,10.5 Z M15.2,15.2 L20.5,20.5 M10.5,8 V13 M8,10.5 H13</Geometry>
        <Geometry x:Key="IcoImage">M3,5 H21 V19 H3 Z M3,16 L9,10 L14,15 L17,12 L21,16 M15.5,8.5 A1,1 0 1 0 15.6,8.5</Geometry>

        <!-- ───────── Controles ───────── -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FF0C0D11" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Line}" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- Icono dibujado con trazo; hereda el color del texto del botón -->
        <Style x:Key="Ico" TargetType="Path">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="StrokeThickness" Value="1.7" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}" />
            <Setter Property="SnapsToDevicePixels" Value="False" />
        </Style>

        <Style x:Key="ToolButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="GroupName" Value="Tools" />
            <Setter Property="ToolTipService.Placement" Value="Right" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="250" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="11">
                            <Path Style="{StaticResource Ico}" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg2}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentGradient}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botón discreto: icono (Tag) + texto opcional (Content) -->
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path x:Name="Icon" Style="{StaticResource Ico}" Data="{TemplateBinding Tag}" Stroke="{TemplateBinding Foreground}"
                                      Width="24" Height="24">
                                    <Path.LayoutTransform>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Path.LayoutTransform>
                                </Path>
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" Margin="6,0,2,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Label" Property="Margin" Value="2,0" />
                            </Trigger>
                            <Trigger Property="Content" Value="{x:Null}">
                                <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg2}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Line}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Background" Value="{StaticResource Bg2}" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource AccentGradient}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Path Style="{StaticResource Ico}" Data="{TemplateBinding Tag}" Stroke="White">
                                    <Path.LayoutTransform>
                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                    </Path.LayoutTransform>
                                </Path>
                                <ContentPresenter VerticalAlignment="Center" Margin="6,0,2,0" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Margin" Value="3,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#66FFFFFF" StrokeThickness="1" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.RenderTransform>
                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Dot" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.25" ScaleY="1.25" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Deslizador fino -->
        <Style x:Key="SliderFill" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="20">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmpty" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" Height="20" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Height" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Bg3}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFill}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmpty}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Cursor="Hand">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Width="14" Height="14" Fill="White" Stroke="{StaticResource Accent}" StrokeThickness="3" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Interruptor -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <DockPanel Background="Transparent">
                            <Border x:Name="Track" DockPanel.Dock="Right" Width="36" Height="20" CornerRadius="10" Background="{StaticResource Bg3}">
                                <Ellipse x:Name="Knob" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0" />
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Barras de desplazamiento finas y oscuras -->
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" CornerRadius="4" Background="#FF3D4254" Margin="2" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#FF596079" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="12" />
            <Setter Property="MinWidth" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}" />
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="MinHeight" Value="12" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ScrollBar">
                                <Grid Background="Transparent">
                                    <Track x:Name="PART_Track">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource ScrollPage}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource ScrollPage}" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource ScrollThumb}" />
                                        </Track.Thumb>
                                    </Track>
                                </Grid>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Application.Resources>
</Application>
